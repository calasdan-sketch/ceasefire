{
  "name": "ceasefire",
  "version": "0.3.0",
  "description": "Parallel agents, zero merge fights. Intent ledger + merge-tree collision forecasting for AI agent fleets.",
  "license": "MIT",
  "author": "Calas Automations Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calasdan-sketch/ceasefire.git"
  },
  "homepage": "https://github.com/calasdan-sketch/ceasefire#readme",
  "bugs": {
    "url": "https://github.com/calasdan-sketch/ceasefire/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "git",
    "merge-conflicts",
    "merge-tree",
    "claude-code",
    "mcp",
    "cursor",
    "codex",
    "worktree"
  ],
  "type": "module",
  "bin": {
    "ceasefire": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "bench": "tsc && node bench/accuracy.mjs --histories 40 && node bench/latency.mjs",
    "build": "tsc",
    "test": "node scripts/test.mjs",
    "prepublishOnly": "node scripts/test.mjs",
    "mutation": "node scripts/mutation-check.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
